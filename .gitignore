# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# Virtual environments
.venv/
venv/
env/
.python-version

# Packaging / build artifacts
build/
dist/
*.egg-info/
.eggs/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets
service_account.json
.streamlit/secrets.toml
**/.streamlit/secrets.toml
secrets/

# Mutmut SQLite cache (mutmut itself is no longer used; this guards against
# any stray re-install accidentally committing the binary cache file).
.mutmut-cache

# Ad-hoc scratch / experimentation. Anything you don't want to commit but
# also don't want to lose to ``git clean`` belongs here. See
# docs/skills/repo-hygiene.md for the convention.
.scratch/
scratch/
*.scratch
*.tmp

# Claude / agent scratch
.claude/settings.json
.claude/worktrees/
